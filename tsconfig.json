{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@mackwan84/dsh-image": ["./packages/image/src/index.ts"],
      "@mackwan84/dsh-image-dashscope": ["./packages/image-dashscope/src/index.ts"],
      "@mackwan84/dsh-image-volcengine": ["./packages/image-volcengine/src/index.ts"],
      "@mackwan84/dsh-tool-ui-mockup": ["./packages/tool-ui-mockup/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/*/tsdown.config.ts",
    "tests",
    "scripts",
    "vitest.config.ts"
  ]
}
